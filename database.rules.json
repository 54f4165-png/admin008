{
  "rules": {
    ".read": false,
    ".write": false,
    "approvedUsers": {
      ".read": "auth != null && root.child('adminUids').child(auth.uid).val() === true",
      "$username": {
        ".read": true,
        ".write": "auth != null && root.child('adminUids').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['username', 'approved']) && newData.child('username').isString() && newData.child('approved').val() === true"
      }
    },
    "adminUids": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    }
  }
}
